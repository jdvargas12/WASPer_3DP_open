<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\00_Release\WASPer.Version.props" />

	<!-- ? Build target and settings -->
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<TargetExt>.gha</TargetExt>
		<LangVersion>latest</LangVersion>
		<NoWarn>NU1701;NETSDK1086;CA1416</NoWarn>

		<!-- SDK baseline shared with Robots.Rhino 2.2.5. -->
		<GrasshopperSdkVersion>8.21.25188.17001</GrasshopperSdkVersion>
	</PropertyGroup>

	<!-- ? Assembly + Yak info -->
	<PropertyGroup>
		<Title>WASPer_3DP</Title>
		<Company>Juan Diego Vargas</Company>
		<Description>WASPer_3DP is a Rhino 8 / Grasshopper plugin for computational design and digital fabrication of 3D-printed building components. It connects geometry processing, implicit fields, infill generation, planar and non-planar slicing, printing-path preparation, G-code workflows, material libraries, facade systems, visualization, and design studies inside one parametric environment.</Description>
	</PropertyGroup>


	<!-- ? Generate manifest automatically from ghuser and examples -->
	<PropertyGroup>
		<YakManifestHeader>$(WASPerManifestHeader)</YakManifestHeader>
		<WebViewerProject>$(MSBuildProjectDirectory)\..\04_WASPer_3DP.XR\07_WebViewer\WASPer.XR.WebViewer\WASPer.XR.WebViewer.csproj</WebViewerProject>
		<WebViewerScripts>$(MSBuildProjectDirectory)\..\04_WASPer_3DP.XR\07_WebViewer\scripts</WebViewerScripts>
		<StopWebViewerOnBuild Condition="'$(StopWebViewerOnBuild)' == ''">true</StopWebViewerOnBuild> 
	</PropertyGroup>

	<!-- Pass -p:SkipYakManifest=true for a fast compile-only build (e.g. CI): skips the
	     WebViewer publish and manifest generation, which need the sibling XR project
	     and network access to restore, and are irrelevant to "does the C# compile". -->
	<Target Name="PublishBundledWebViewer" BeforeTargets="GenerateYakManifest" Condition="'$(SkipYakManifest)' != 'true'">
		<Message Importance="high" Text="Publishing bundled WASPer XR WebViewer to $(TargetDir)webviewer\app" />
		<Message Condition="'$(StopWebViewerOnBuild)' == 'true'" Importance="high" Text="Stopping running WASPer XR WebViewer processes before replacing the bundled viewer" />
		<Exec Condition="'$(StopWebViewerOnBuild)' == 'true'" Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-Process -Name 'WASPer.XR.WebViewer' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 250&quot;" />
		<Exec Condition="Exists('$(TargetDir)webviewer\app')" Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$p='$(TargetDir)webviewer\app'; Get-ChildItem -LiteralPath $p -Recurse -Force | ForEach-Object { $_.Attributes = 'Normal' }; (Get-Item -LiteralPath $p -Force).Attributes = 'Directory'&quot;" />
		<RemoveDir Directories="$(TargetDir)webviewer\app" Condition="Exists('$(TargetDir)webviewer\app')" />
		<MakeDir Directories="$(TargetDir)webviewer\app;$(TargetDir)webviewer\scripts" />
		<Exec Command="dotnet publish &quot;$(WebViewerProject)&quot; -c $(Configuration) -r win-x64 --self-contained false -o &quot;$(TargetDir)webviewer\app&quot;" />
		<Copy SourceFiles="$(WebViewerScripts)\Start-WASPerWebViewer.ps1;$(WebViewerScripts)\Package-StandaloneViewer.ps1"
			DestinationFolder="$(TargetDir)webviewer\scripts\" />
	</Target>

	<Target Name="GenerateYakManifest" AfterTargets="CoreBuild" Condition="'$(SkipYakManifest)' != 'true'">
		<Message Importance="high" Text="GenerateYakManifest running. TargetDir=$(TargetDir)" />
		<Message Importance="high" Text="YakManifestHeader=$(YakManifestHeader)" />

	<ItemGroup>
		<Compile Include="Components\0.0_WASPer_3DP\WASPerMascot.cs" />
		<Compile Include="Components\1.1_Data Vis\wsp_Da06_Pareto Front.cs" />
    <Compile Include="Components\1.1_Data Vis\wsp_Da07_3D Graph.cs" />
    <Compile Include="Components\1.1_Data Vis\wsp_Da08_Parallel Coordinates.cs" />
			<_GhUserFiles Include="Resources\Ghuser\*.ghuser" />
			<_ExampleFiles Include="Resources\Examples\**\*.gh;Resources\Examples\**\*.ghx" />
			<_MaterialLib Include="Resources\Mat_lib\**\*.xlsx" />
			<_WebViewerFiles Include="$(TargetDir)webviewer\**\*" />
			<_WebViewerFiles>
				<ManifestPath>$([System.String]::Copy('webviewer/%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))</ManifestPath>
			</_WebViewerFiles>
  </ItemGroup>

		<ItemGroup>
			<_ManifestGhuserLines Include="@(_GhUserFiles->'  - file: ghuser/%(RecursiveDir)%(Filename)%(Extension)')" />
			<_ManifestExampleLines Include="@(_ExampleFiles->'  - file: examples/%(RecursiveDir)%(Filename)%(Extension)')" />
			<_BuiltInManifestFile Include="_built_in_examples.txt" />
			<_ManifestExampleLines Include="@(_BuiltInManifestFile->'  - file: examples/%(Identity)')" />
			<_BuiltInExampleNameLines Include="@(_ExampleFiles->'%(RecursiveDir)%(Filename)%(Extension)')" />
			<_ManifestMatLines Include="@(_MaterialLib->'  - file: mat_lib/%(RecursiveDir)%(Filename)%(Extension)')" />
			<_ManifestWebViewerLines Include="@(_WebViewerFiles->'  - file: %(ManifestPath)')" />
		</ItemGroup>

		<ItemGroup>
			<_ManifestGeneratedLines Include="# user_objects" />
			<_ManifestGeneratedLines Include="@(_ManifestGhuserLines)" />

			<_ManifestGeneratedLines Include="# examples" />
			<_ManifestGeneratedLines Include="@(_ManifestExampleLines)" />

			<_ManifestGeneratedLines Include="# materials" />
			<_ManifestGeneratedLines Include="@(_ManifestMatLines)" />

			<_ManifestGeneratedLines Include="# webviewer" />
			<_ManifestGeneratedLines Include="@(_ManifestWebViewerLines)" />

			<_ManifestGeneratedLines Include="#main icon" />
			<_ManifestGeneratedLines Include="icon: 00_WASPer_3DP.png" />

			<_ManifestGeneratedLines Include="#time: $([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))" />
		</ItemGroup>

		<MakeDir Directories="$(TargetDir)examples" />
		<WriteLinesToFile File="$(TargetDir)examples\_built_in_examples.txt" Lines="@(_BuiltInExampleNameLines)" Overwrite="true" Encoding="UTF-8" />
		<!-- Copy preserves YAML indentation; converting header lines to MSBuild items strips leading spaces. -->
		<Copy SourceFiles="$(YakManifestHeader)" DestinationFiles="$(TargetDir)manifest.yml" />
		<WriteLinesToFile File="$(TargetDir)manifest.yml" Lines="@(_ManifestGeneratedLines)" Overwrite="false" Encoding="UTF-8" />
	</Target>

