	<!-- Keep generated user-object output in sync with Resources\Ghuser only.
	     Without this, deleted/archived .ghuser files can linger in bin\...\ghuser. -->
	<Target Name="SyncActiveGhuserOutput" AfterTargets="Build">
		<Message Importance="high" Text="SyncActiveGhuserOutput running from Resources\Ghuser to $(TargetDir)ghuser" />
		<ItemGroup>
			<_ActiveGhuserFiles Include="$(MSBuildProjectDirectory)\Resources\Ghuser\*.ghuser" />
			<_GeneratedGhuserOutput Include="$(TargetDir)ghuser\*.ghuser" />
		</ItemGroup>
		<MakeDir Directories="$(TargetDir)ghuser" />
		<Delete Files="@(_GeneratedGhuserOutput)" TreatErrorsAsWarnings="true" />
		<Copy SourceFiles="@(_ActiveGhuserFiles)" DestinationFolder="$(TargetDir)ghuser\" />
	</Target>

